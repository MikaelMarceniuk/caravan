# Copy to infra/.env to override the defaults of compose.dev.yml (local development only).

# Host ports, bound to 127.0.0.1. The defaults avoid 5432 and 6379, often taken by other projects.
CARAVAN_POSTGRES_PORT=5433
CARAVAN_REDIS_PORT=6380

# Dev credentials. Production sets its own, with no defaults.
CARAVAN_POSTGRES_USER=caravan
CARAVAN_POSTGRES_PASSWORD=caravan
CARAVAN_POSTGRES_DB=caravan
