# Copy to apps/api/.env (local development only). Required: the API and the tests don't start without it.
# The defaults of infra/compose.dev.yml. The tests create and drop `caravan_test` next to this database.
DATABASE_URL=postgres://caravan:caravan@127.0.0.1:5433/caravan

# Required by the API (the tests set their own). Signs the session cookies: any random value of 32+ characters
# in development (`openssl rand -base64 32`); production has its own, never this one.
BETTER_AUTH_SECRET=development-secret-change-me-0123456789
# The web's origin, which the browser sees (not the API's): email links and cookies belong to it, and the web
# forwards /api/* to the API.
BETTER_AUTH_URL=http://localhost:3000

# Required by the API (the tests use a fake). Resend's API key (https://resend.com/api-keys) and the sender.
# Until the domain is verified, Resend only delivers mail from onboarding@resend.dev to the account owner's address.
RESEND_API_KEY=re_your_key
EMAIL_FROM="Caravan <onboarding@resend.dev>"

# Optional. Port the API listens on (default 3333; the web takes 3000).
PORT=3333
