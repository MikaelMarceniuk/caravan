{
	"$schema": "https://turborepo.com/schema.json",
	"globalDependencies": ["tsconfig.base.json", "biome.json"],
	"tasks": {
		"lint": {
			"inputs": [
				"src/**",
				"__tests__/**",
				"package.json",
				"tsconfig*.json",
				"biome.json",
				"drizzle.config.ts",
				"scripts/**",
				"theme.css"
			],
			"outputs": []
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"src/**",
				"__tests__/**",
				"package.json",
				"tsconfig*.json",
				"drizzle.config.ts",
				"scripts/**",
				"theme.css"
			],
			"outputs": []
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["src/**", "package.json", "tsconfig*.json"],
			"outputs": ["dist/**"]
		},
		"test": {
			"dependsOn": ["typecheck"],
			"inputs": [
				"src/**",
				"__tests__/**",
				"package.json",
				"tsconfig*.json",
				"drizzle.config.ts",
				"scripts/**",
				"theme.css"
			],
			"env": ["DATABASE_URL"],
			"outputs": []
		}
	}
}
