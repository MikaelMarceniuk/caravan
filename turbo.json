{
	"$schema": "https://turborepo.com/schema.json",
	"globalDependencies": ["tsconfig.base.json", "biome.json"],
	"tasks": {
		"lint": {
			"inputs": [
				"src/**",
				"__tests__/**",
				"package.json",
				"tsconfig*.json",
				"biome.json",
				"drizzle.config.ts",
				"scripts/**",
				"theme.css",
				"messages/**",
				"public/**",
				"next.config.ts",
				"postcss.config.mjs",
				"components.json",
				"bunfig.toml"
			],
			"outputs": []
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"src/**",
				"__tests__/**",
				"package.json",
				"tsconfig*.json",
				"drizzle.config.ts",
				"scripts/**",
				"theme.css",
				"messages/**",
				"public/**",
				"next.config.ts",
				"postcss.config.mjs",
				"components.json",
				"bunfig.toml"
			],
			"outputs": []
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**",
				"package.json",
				"tsconfig*.json",
				"messages/**",
				"public/**",
				"next.config.ts",
				"postcss.config.mjs",
				"components.json",
				"bunfig.toml"
			],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"],
			"env": ["API_URL"]
		},
		"test": {
			"dependsOn": ["typecheck"],
			"inputs": [
				"src/**",
				"__tests__/**",
				"package.json",
				"tsconfig*.json",
				"drizzle.config.ts",
				"scripts/**",
				"theme.css",
				"messages/**",
				"public/**",
				"next.config.ts",
				"postcss.config.mjs",
				"components.json",
				"bunfig.toml"
			],
			"env": ["DATABASE_URL"],
			"outputs": []
		}
	}
}
