{
	"name": "caravan",
	"private": true,
	"packageManager": "bun@1.4.3",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check": "bun run lint:root && turbo run lint typecheck build test",
		"lint": "bun run lint:root && turbo run lint",
		"lint:root": "biome ci *.json",
		"format": "biome check --write .",
		"typecheck": "turbo run typecheck",
		"build": "turbo run build",
		"test": "turbo run test",
		"infra:up": "docker compose -f infra/compose.yml -f infra/compose.dev.yml up -d --wait",
		"infra:down": "docker compose -f infra/compose.yml -f infra/compose.dev.yml down",
		"infra:reset": "docker compose -f infra/compose.yml -f infra/compose.dev.yml down -v",
		"infra:check": "infra/check.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/bun": "1.4.3",
		"turbo": "2.11.10",
		"typescript": "7.0.2"
	}
}
